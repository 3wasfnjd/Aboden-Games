---
import { loadCatalog } from '../../lib/catalog.ts';
import { renderPlay } from '../../lib/site.ts';
export function getStaticPaths() {
  return loadCatalog().filter(p => p.liveUrl && p.slug !== 'ar-aboden').map(project => ({ params: { slug: project.slug }, props: { project } }));
}
const html = renderPlay(Astro.props.project, import.meta.env.BASE_URL);
---
<Fragment set:html={html} />
